# ============================================================
# J R P O S  —  Plantilla de variables de entorno (VPS / Docker)
# Copia este archivo a `.env` y completa los valores.
#   cp .env.example .env
# NUNCA hagas commit del archivo .env real.
# ============================================================

# --- Dominio (usado por Traefik para enrutar y por Caddy como fallback local) ---
# Sin dominio publico, dejalo en localhost (Caddy usara certificado self-signed)
DOMAIN=tu-dominio.com

# --- Traefik (docker-compose.traefik.yml) ---
# Email de contacto para el registro ACME de Let's Encrypt (obligatorio,
# Let's Encrypt lo exige para avisar antes de que expire un certificado).
ACME_EMAIL=tu-email@tu-dominio.com

# --- Base de datos (contenedor Postgres del compose) ---
# POSTGRES_USER es el rol bootstrap del cluster -- Postgres SIEMPRE lo crea
# superusuario, y un superusuario ignora Row-Level Security (backend/db_migrations.py)
# sin importar FORCE ROW LEVEL SECURITY. El backend NO se conecta con este rol.
POSTGRES_USER=jrpos
POSTGRES_PASSWORD=cambia-esta-password-fuerte
POSTGRES_DB=jrpos

# Rol de aplicacion sin privilegios de superusuario -- docker/postgres-init.sh
# lo crea automaticamente en un volumen nuevo. DATABASE_URL debe usar ESTE
# rol (no POSTGRES_USER) para que las politicas RLS apliquen de verdad.
POSTGRES_APP_USER=jrpos_app
POSTGRES_APP_PASSWORD=cambia-esta-otra-password-fuerte

# URL de conexion para el backend. En VPS (docker compose) apunta al
# servicio interno `postgres` con el rol de aplicacion de arriba. En
# Supabase/Vercel usa el pooler:
#   postgresql://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://jrpos_app:cambia-esta-otra-password-fuerte@postgres:5432/jrpos

# --- Seguridad ---
# OBLIGATORIO en produccion: el backend arranca con error si falta (ENV=production).
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# production activa cookies Secure (requiere HTTPS) y validaciones estrictas.
# En desarrollo local sin HTTPS usa: ENV=development
ENV=production

# --- Seeds iniciales (se ejecutan al arrancar si las tablas estan vacias) ---
ADMIN_EMAIL=admin@tu-dominio.com
ADMIN_PASSWORD=cambia-esta-password-admin
SUPERADMIN_EMAIL=super@tu-dominio.com
SUPERADMIN_PASSWORD=cambia-esta-password-superadmin

# --- Frontend / CORS ---
FRONTEND_URL=https://tu-dominio.com
FRONTEND_URL_REGEX=

# --- SaaS: trial de 15 dias por tenant (0 = sin trial) ---
TRIAL_DAYS=15

# --- Registro: dominios de correo permitidos (separados por coma) ---
# Vacio/ausente = cualquier dominio puede registrarse.
# REGISTRATION_ALLOWED_DOMAINS=gmail.com,hotmail.com,miempresa.co

# --- SMTP para correos del sistema (bienvenida al registrar) ---
# Recomendado: Brevo (300 correos/dia gratis) - smtp-relay.brevo.com:587
# Alternativas: Resend (smtp.resend.com:587), Mailgun, SES, Gmail (app-password, smtp.gmail.com:465)
# Sin SMTP_HOST el sistema sigue funcionando (el correo se omite y se registra en logs).
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=JRPOS <no-reply@tu-dominio.com>

# --- Claves de IA/OCR de la PLATAFORMA (Pool Multi-Proveedor con Failover Automático) ---
# El enrutador intenta en orden: Gemini -> NVIDIA NIM -> OpenRouter -> Groq -> Routers Adicionales.
# Si un proveedor se satura (429/503), conmuta automáticamente al siguiente disponible.
# GEMINI_API_KEY=
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# TOKENROUTER_API_KEY=
# TOKENROUTER_BASE_URL=https://api.tokenrouter.io/v1
# ORCAROUTER_API_KEY=
# ORCAROUTER_BASE_URL=https://api.orcarouter.com/v1
# CUSTOM_OCR_BASE_URL=
# CUSTOM_OCR_API_KEY=
# CUSTOM_OCR_MODEL=
# Cupo diario de OCR por tenant cuando usa la clave de plataforma (default 50)
# OCR_PLATFORM_DAILY_LIMIT=50

# --- Pagos (transferencia / QR mostrados en el paywall) ---
PAYMENT_BANK_INFO=
PAYMENT_QR_URL=
PAYMENT_WHATSAPP=
PAYMENT_NEQUI_NUMBER=
PAYMENT_BREB_KEY=

# --- Opcional: integraciones ---
# GOOGLE_CLIENT_ID=
# GEMINI_API_KEY=  (ver bloque "Claves de IA/OCR de la PLATAFORMA" arriba)
