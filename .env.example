# ============================================================
# J R P O S  —  Plantilla de variables de entorno (VPS / Docker)
# Copia este archivo a `.env` y completa los valores.
#   cp .env.example .env
# NUNCA hagas commit del archivo .env real.
# ============================================================

# --- Dominio (usado por Caddy para HTTPS automatico con Let's Encrypt) ---
# Sin dominio publico, dejalo en localhost (Caddy usara certificado self-signed)
DOMAIN=tu-dominio.com

# --- Base de datos (contenedor Postgres del compose) ---
# POSTGRES_USER es el rol bootstrap del cluster -- Postgres SIEMPRE lo crea
# superusuario, y un superusuario ignora Row-Level Security (backend/db_migrations.py)
# sin importar FORCE ROW LEVEL SECURITY. El backend NO se conecta con este rol.
POSTGRES_USER=jrpos
POSTGRES_PASSWORD=cambia-esta-password-fuerte
POSTGRES_DB=jrpos

# Rol de aplicacion sin privilegios de superusuario -- docker/postgres-init.sh
# lo crea automaticamente en un volumen nuevo. DATABASE_URL debe usar ESTE
# rol (no POSTGRES_USER) para que las politicas RLS apliquen de verdad.
POSTGRES_APP_USER=jrpos_app
POSTGRES_APP_PASSWORD=cambia-esta-otra-password-fuerte

# URL de conexion para el backend. En VPS (docker compose) apunta al
# servicio interno `postgres` con el rol de aplicacion de arriba. En
# Supabase/Vercel usa el pooler:
#   postgresql://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://jrpos_app:cambia-esta-otra-password-fuerte@postgres:5432/jrpos

# --- Seguridad ---
# OBLIGATORIO en produccion: el backend arranca con error si falta (ENV=production).
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# production activa cookies Secure (requiere HTTPS) y validaciones estrictas.
# En desarrollo local sin HTTPS usa: ENV=development
ENV=production

# --- Seeds iniciales (se ejecutan al arrancar si las tablas estan vacias) ---
ADMIN_EMAIL=admin@tu-dominio.com
ADMIN_PASSWORD=cambia-esta-password-admin
SUPERADMIN_EMAIL=super@tu-dominio.com
SUPERADMIN_PASSWORD=cambia-esta-password-superadmin

# --- Frontend / CORS ---
FRONTEND_URL=https://tu-dominio.com
FRONTEND_URL_REGEX=

# --- SaaS: trial de 14 dias por tenant (0 = sin trial) ---
TRIAL_DAYS=14

# --- Pagos (transferencia / QR mostrados en el paywall) ---
PAYMENT_BANK_INFO=
PAYMENT_QR_URL=
PAYMENT_WHATSAPP=
PAYMENT_NEQUI_NUMBER=
PAYMENT_BREB_KEY=

# --- Opcional: integraciones ---
# GOOGLE_CLIENT_ID=
# GEMINI_API_KEY=
