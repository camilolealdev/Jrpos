# Copia este archivo a ".env" en la raíz del repo y completa los valores reales.
# Nunca commitees el ".env" real (ya está en .gitignore).

# --- Dominio (Caddy obtiene HTTPS automático vía Let's Encrypt para un dominio real) ---
DOMAIN=tu-dominio.com

# --- Postgres (contenedor propio, reemplaza a Supabase) ---
POSTGRES_USER=jrpos
POSTGRES_PASSWORD=cambia-esto-por-una-contrasena-segura
POSTGRES_DB=jrpos

# DATABASE_URL debe usar el mismo usuario/password/db de arriba, apuntando
# al servicio "postgres" de docker-compose (no localhost, no Supabase).
DATABASE_URL=postgresql://jrpos:cambia-esto-por-una-contrasena-segura@postgres:5432/jrpos
# En un Postgres propio no hay distinción pooled/unpooled (eso era solo para
# el pooler de Supabase) — usa el mismo valor de arriba. La necesitan las
# migraciones Alembic que corren al arrancar el contenedor (docker-entrypoint.sh).
DATABASE_URL_UNPOOLED=postgresql://jrpos:cambia-esto-por-una-contrasena-segura@postgres:5432/jrpos

# --- Backend (backend/auth.py, backend/app.py) ---
ENV=production
JWT_SECRET=genera-uno-con-openssl-rand-hex-32
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=cambia-esto-por-una-contrasena-segura
FRONTEND_URL=https://tu-dominio.com
GEMINI_API_KEY=tu-api-key-de-gemini-si-usas-escaneo-de-facturas-con-ia

# Login/registro con Google. Crea un OAuth Client ID tipo "Web application" en
# https://console.cloud.google.com/apis/credentials (mismo valor que
# REACT_APP_GOOGLE_CLIENT_ID en frontend/.env).
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# --- Trial (dias antes de exigir plan pago; 365 = 1 anio) ---
TRIAL_DAYS=365

# --- Cobro de plataforma (paywall post-trial, fase 1 manual) ---
PAYMENT_QR_URL=/payment-qr.png
PAYMENT_BANK_INFO=Bancolombia ahorros 123-456789-01 a nombre de JRPOS / Nequi 3001234567
PAYMENT_WHATSAPP=573001234567

# --- Cuenta SuperAdmin de la plataforma (se siembra al arrancar) ---
SUPERADMIN_EMAIL=super@jrpos.co
SUPERADMIN_PASSWORD=genera-una-clave-fuerte
