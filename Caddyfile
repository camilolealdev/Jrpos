{
	auto_https off
}

:80 {
	encode gzip
	log {
		output stdout
		format console
	}

	header {
		Cross-Origin-Opener-Policy same-origin-allow-popups
	}

	# API requests go to the backend container.
	@api path /api /api/*
	handle @api {
		reverse_proxy jrpos-backend:8000
	}

	# Everything else is the React SPA build.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
