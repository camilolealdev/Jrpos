:80 {
	encode gzip
	log {
		output stdout
		format console
	}

	# API requests go to the backend container. Caddy auto-provisions
	# HTTPS via Let's Encrypt for a real domain (falls back to a local
	# self-signed cert for "localhost").
	@api path /api /api/*
	handle @api {
		reverse_proxy backend:8000
	}

	# Everything else is the React SPA build.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
